# Which AI backs the chat widget: "ollama" (local, free, needs Ollama running
# on this machine) or "gemini" (hosted, free tier, needed once real site
# visitors need to reach it — Ollama only serves localhost).
AI_PROVIDER=ollama

# --- ollama ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b

# --- gemini ---
# Get a free key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# SERVER_PORT=8787
